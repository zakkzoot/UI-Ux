NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/app_db?schema=public"

# JWT — use strong random secrets in production (openssl rand -base64 64)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=12

# CORS: comma-separated origins or * for all
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
